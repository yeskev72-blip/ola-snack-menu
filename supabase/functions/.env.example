# Secrets de l'Edge Function analyze-meal (copier en supabase/functions/.env pour le local,
# ou les définir en production avec : npx supabase secrets set --env-file supabase/functions/.env).
# Ce fichier .env ne doit jamais être commité : il contient la clé Gemini.
GEMINI_API_KEY=
# Alias tenus à jour par Google : modèle léger (offre gratuite), puis secours.
GEMINI_MODEL=gemini-flash-lite-latest
# Modèles de secours quand le principal est saturé (erreur 503), séparés par des virgules ; « none » pour désactiver.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-flash-latest
# Les deux réglages suivants ne servent qu'avec GEMINI_STRUCTURED=true (schéma JSON imposé,
# refusé en HTTP 400 par les modèles actuels).
# 0.3 par défaut (cahier des charges). Google recommande de laisser la valeur par défaut
# des modèles Gemini 3 : mettre « default » pour ne pas envoyer de température.
GEMINI_TEMPERATURE=0.3
GEMINI_THINKING_LEVEL=low
# Conserver les photos (uniquement si l'utilisateur a accepté le partage) : true / false.
STORE_PHOTOS=false
